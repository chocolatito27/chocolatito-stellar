node_modules/
dist/
.env
.env.local
# La clave secreta de Stellar NUNCA entra al repositorio. El flujo de trabajo
# la guarda en el perfil del usuario, no en el proyecto: si alguna vez aparece
# un archivo asi aqui, es un error, no una excepcion.
*.secret
llaves/
.wrangler/

# Los cuadros sueltos y la captura son material de trabajo del grabador: se
# regeneran con `node --experimental-strip-types guiones/grabar.ts`. El MP4 si
# entra al repo, porque es el entregable.
video/cuadros/
video/revision/
video/cuadros.txt
video/captura.json
video/hash.txt
datos/taller/

# La carpeta donde trabaja el agente en la grabacion interactiva: se crea sola.
facturas-enero-marzo-2026/

# Lo que generan los guiones de video/fuentes al montar: se rehace con ellos.
video/fuentes/*.png
video/fuentes/*.wav
video/fuentes/*.mp3
video/fuentes/*.mp4
video/fuentes/linea.json
video/fuentes/piezas.txt
